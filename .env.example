# MQTT Configuration
MQTT_BROKER_URL=mqtt://192.168.68.119:1883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_CLIENT_ID=homeautomation-app

# HTTP Configuration
HTTP_TIMEOUT=30000

# Http/Prometheus Configuration
HTTP_PORT=1881

POWER_CONTROL_ENABLED=true

FORECAST_SOLAR_API_KEY=<insert_api_key>

VICTRON_API_KEY=<insert_api_key>
VICTRON_PORTAL_ID=
VICTRON_INSTALLATION_ID=

JSONBIN_ID=<insert_jsonbin_id>
# Access key with Bins Read and Update permissions (preferred).
JSONBIN_ACCESS_KEY=
# Required for public bins to disable versioning; preferred for writes.
JSONBIN_MASTER_KEY=

# Logging configuration
HOST_ID=your_host_id
LOGLAYER_SOURCE_ID=your_loglayer_source_id
LOGLAYER_API_KEY=your_loglayer_api_key
