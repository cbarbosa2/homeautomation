{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-cron --watch src/bootstrap.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-cron src/bootstrap.ts",
    "bmw:setup": "deno run --allow-net --allow-read --allow-write --allow-env scripts/bmw-cardata-setup.ts",
    "check": "deno check src/*.ts && deno task test",
    "lint": "deno lint src/",
    "fmt": "deno fmt src/",
    "test": "VICTRON_PORTAL_ID=test-portal VICTRON_INSTALLATION_ID=123456 deno test --allow-net --allow-read --allow-write --allow-env --unstable-cron",
    "analyze": "deno task check && deno task lint",
    "compile": "deno check src/**/*.ts"
  },
  "imports": {
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "mqtt": "npm:mqtt@^5.16.1",
    "prom-client": "npm:prom-client@^15.1.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@js-temporal/polyfill": "npm:@js-temporal/polyfill@^0.5.1",
    "loglayer": "npm:loglayer@^9.4.0",
    "@loglayer/transport-logflare": "npm:@loglayer/transport-logflare@^2.3.0",
    "serialize-error": "npm:serialize-error@^13.1.0"
  },
  "compilerOptions": {
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
