{
  "name": "homeautomation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "typecheck": "node scripts/check-node.mjs && tsc --noEmit",
    "build": "npm run typecheck && node scripts/clean-output.mjs dist && tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/src/bootstrap.js",
    "dev": "node scripts/check-node.mjs && tsc-watch -p tsconfig.build.json --onSuccess \"node dist/src/bootstrap.js\"",
    "test": "node scripts/check-node.mjs && node scripts/clean-output.mjs .test-dist && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm test",
    "lint": "biome lint src scripts",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "analyze": "npm run check && npm run lint && npm run fmt:check",
    "bmw:setup": "npm run build && node dist/scripts/bmw-cardata-setup.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@loglayer/transport-logflare": "2.3.0",
    "loglayer": "9.4.0",
    "mqtt": "5.16.1",
    "node-cron": "^4.2.1",
    "prom-client": "15.1.3",
    "serialize-error": "13.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.0.0",
    "tsc-watch": "^7.2.0",
    "typescript": "^6.0.3"
  }
}
